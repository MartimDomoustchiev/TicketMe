# Tiketko configuration template.
# Copy to .env.local for development. Never commit real credentials.

# Required in production. Use the exact public HTTPS origin, without a trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Required in production: users, opaque sessions, shared inventory state and
# the durable FIFO queue. Local development may leave this empty and use the
# JSON adapters under .data/.
# Examples: Neon, Supabase, Railway, AWS RDS.
DATABASE_URL=""

# Optional alternative to DATABASE_URL. Useful for passwords containing URL
# special characters because the application encodes them safely.
DATABASE_HOST=""
DATABASE_PORT="5432"
DATABASE_NAME=""
DATABASE_USER=""
DATABASE_PASSWORD=""

# AWS RDS: download the official global bundle and keep certificate validation
# enabled. Use one CA source only. The PEM is public, not a secret.
# curl -o global-bundle.pem \
#   https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
DATABASE_SSL_CA_PATH=""
DATABASE_SSL_CA_BASE64=""
DATABASE_SSL_CA=""
DATABASE_POOL_MAX="5"
DATABASE_IDLE_SESSION_TIMEOUT_MS=""
DATABASE_STATEMENT_TIMEOUT_MS="15000"

# Optional admin/migration-role URL. Falls back to the normal database settings.
MIGRATION_DATABASE_URL=""
MIGRATION_STATEMENT_TIMEOUT_MS="60000"

# Development-only escape hatch. Production must use `npm run db:migrate`.
DATABASE_AUTO_MIGRATE="false"

# Required for embedded Stripe Checkout. Keep this key server-only. Use an
# sk_test_ key for test payments, or sk_live_ only when real charging is intended.
STRIPE_SECRET_KEY=""

# Required for embedded Stripe Checkout. This key is safe to expose to the
# browser, but it must belong to the same Stripe account and mode as the secret.
STRIPE_PUBLISHABLE_KEY=""

# Strongly recommended for reliable, idempotent fulfillment even when the buyer
# closes the Stripe page before returning. Copy the endpoint signing secret from
# Stripe or the local Stripe CLI output:
# stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=""

# Required in production: Resend transactional email.
# onboarding@resend.dev can send only to the Resend account owner's address.
# To deliver to Gmail, Outlook, Yahoo, and other recipients, MAIL_FROM must use
# a custom domain that is fully verified in the Resend Domains dashboard.
# Local development may leave these empty. Signup will continue directly to
# verification and a copy of the message is saved in .data/outbox.log.
RESEND_API_KEY=""
MAIL_FROM="Tiketko <tickets@mail.your-domain.com>"

# Required in production: private S3-compatible bucket for ticket PDFs.
# Cloudflare R2: S3_REGION="auto" and set S3_ENDPOINT.
# AWS S3: use the bucket region and leave S3_ENDPOINT empty.
# Local development may leave these empty and use .data/storage/tickets.
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Automated event discovery. Configure only HTTPS feeds that you own or are
# explicitly allowed to ingest and republish. Accepts a JSON array of RSS,
# Atom, iCalendar or JSON feed URLs. Google Search grounding is intentionally
# not used because its terms prohibit building a persistent event database.
EVENT_DISCOVERY_FEED_URLS="[]"
# Optional source links outside each feed hostname, for example:
# ["tickets.organizer.bg","*.partner-feed.example"]
EVENT_DISCOVERY_ALLOWED_HOSTS="[]"
EVENT_DISCOVERY_AUTO_PUBLISH="false"
# Standard Vercel Cron bearer secret for discovery and durable ticket-email
# recovery. Generate at least 32 random characters.
CRON_SECRET=""
# Optional legacy alias for another trusted scheduler.
EVENT_DISCOVERY_CRON_SECRET=""
EVENT_DISCOVERY_MAX_EVENTS="40"
EVENT_DISCOVERY_LOOKAHEAD_DAYS="180"

# Optional server-side enrichment for authorized feed data. Never prefix this
# key with NEXT_PUBLIC_. Keep it empty for a public service likely to be used
# by minors; Google's current Gemini terms prohibit that deployment scenario.
# The model may classify, translate and rank events but cannot invent prices,
# capacity or source facts.
GEMINI_API_KEY=""
