{
  "name": "ticketme",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:sites": "node scripts/build-sites-redirect.mjs",
    "build:cloudflare": "node scripts/build-sites.mjs",
    "art:generate": "tsx scripts/generate-event-art.ts",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:check": "tsx scripts/check-database.ts",
    "db:migrate": "tsx scripts/migrate-database.ts",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/**/*.test.ts",
    "check": "npm run lint && npm run test && npm run build",
    "user:promote": "tsx scripts/promote-user.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1105.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.13.0",
    "fast-xml-parser": "^5.10.1",
    "lucide-react": "^1.29.0",
    "next": "16.3.0",
    "node-ical": "^0.27.1",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.18.1",
    "server-only": "^0.0.1",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "sharp": "0.35.3",
    "tailwindcss": "^4",
    "terser": "^5.49.2",
    "tsx": "^4.23.9",
    "typescript": "^5",
    "wrangler": "^4.115.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
